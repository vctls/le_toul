{
  "name": "the-tuul",
  "version": "0.17.0",
  "description": "Create a decent karaoke video from any song in about 10 minutes.",
  "main": "index.ts",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "dev": "vite --host --config vite.config.dev.ts",
    "build": "vite build --mode production --config vite.config.prod.ts",
    "build-dev": "vite build --config vite.config.dev.ts",
    "watch": "vite build --config vite.config.dev.ts --watch --host",
    "version": "(cd api/ && poetry version $npm_package_version) && git add pyproject.toml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/incidentist/karaoke_video_tools.git"
  },
  "keywords": [
    "karaoke"
  ],
  "author": "Dan Kurtz <andfurthermore@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/incidentist/karaoke_video_tools/issues"
  },
  "homepage": "https://github.com/incidentist/karaoke_video_tools#readme",
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/vue-fontawesome": "^3.2.0",
    "@types/js-yaml": "^4.0.9",
    "audiobuffer-to-wav": "^1.0.0",
    "buefy": "npm:@ntohq/buefy-next@^0.2.0",
    "bulma": "^1.0.4",
    "idb-keyval": "^6.2.4",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "libass-wasm": "^4.1.0",
    "lodash-es": "^4.18.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.34",
    "wavesurfer.js": "^7.12.7"
  },
  "devDependencies": {
    "@ffmpeg/types": "^0.12.4",
    "@playwright/test": "^1.60.0",
    "@types/jsmediatags": "^3.9.6",
    "@types/lodash": "^4.17.24",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "playwright": "^1.60.0",
    "sass-embedded": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.60.4"
  }
}
