# Copy this file to .env and fill in the values
DEBUG=
LOGGING_FORMAT=console
# The name shown in the page title and header. Defaults to Le Toul.
APP_NAME=
YOUTUBE_PROXY=
TUUL_DONATE_URL=
TUUL_API_HOSTNAME=""
# Custom Markdown for the Intro tab, built into the bundle. A file path, relative to the repository
# root, wins over inline Markdown. Docker builds take only the inline form.
# A line holding only {intro} places the built-in intro. Without one, the custom text replaces it.
# A link to #load-example, such as [Try it](#load-example), loads the example song.
INTRO_FILE=
INTRO_MARKDOWN=
SEPARATED_TRACKS_BUCKET=
# Where empty lyrics are looked up: lrclib, or empty to turn the lookup off.
LYRICS_PROVIDER=lrclib
# The model preselected in the UI, by file name. Defaults to mel_band_roformer_karaoke_becruily.ckpt.
DEFAULT_SEPARATION_MODEL=
# in_process | subprocess | remote | passthrough
SEPARATION_BACKEND=in_process
# Container for the separated stems. flac is lossless and about half the size of wav.
SEPARATION_OUTPUT_FORMAT=wav
# Where models are downloaded to. Defaults to api/pretrained_models.
MODELS_DIR=
# Read by compose.modal.yaml: the Modal web function's URL and a workspace proxy token.
MODAL_SEPARATION_URL=
MODAL_PROXY_KEY=
MODAL_PROXY_SECRET=
