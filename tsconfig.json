{
  "compilerOptions": {
    "target": "ES2022",
    "strict": true,
    "sourceMap": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "ES2022",
    "paths": {
      "@/*": ["./frontend/*"],
      "@/lib/*": ["./frontend/lib/*"]
    },
    "types": ["vitest/globals"]
  },
  "exclude": ["node_modules", "frontend/sw.ts"],
  "vueCompilerOptions": {
    "strictTemplates": true,
    "target": 3.5
  }
}
